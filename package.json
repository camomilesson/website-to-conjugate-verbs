{
  "name": "la-conjugadora",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "description": "",
  "scripts": {
    "start": "vite",
    "check": "tsc --noEmit",
    "lint-typecheck": "tsc --noEmit",
    "lint-eslint": "eslint .",
    "lint-prettier": "prettier --check .",
    "lint": "pnpm run lint-typecheck && pnpm run lint-eslint && pnpm run lint-prettier",
    "format": "prettier --write .",
    "dev": "vite",
    "build": "pnpm check && pnpm validate:catalogue && vite build",
    "preview": "vite preview",
    "examples": "node src/examples/index.ts",
    "test": "node --test src/modules/*/*.test.ts",
    "validate:catalogue": "node --test src/modules/verb-catalogue/catalogue.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  }
}
